generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Platform / Tenancy ----------

enum BusinessType {
  SOLAR
  GENERIC // placeholder for future verticals
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  businessType    BusinessType @default(SOLAR)
  isActive        Boolean      @default(true)
  // Letterhead details for printed estimates — edited by the tenant Admin
  // via the Business Profile page, not by Super Admin at onboarding time.
  businessAddress String?
  gstin           String?
  contactPhone    String?
  contactEmail    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users               User[]
  leads               Lead[]
  estimates           Estimate[]
  inventoryItems      InventoryItem[]
  inventoryTxns       InventoryTransaction[]
  connections         Connection[]
  customerPayments    CustomerPayment[]
  staffMembers        StaffMember[]
  leadNotes           LeadNote[]
  sitePhotos          SitePhoto[]
}

enum Role {
  SUPER_ADMIN // platform-level, tenantId is null
  ADMIN // tenant-scoped owner
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String
  role              Role
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  isActive          Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

// ---------- Leads ----------

enum LeadStage {
  NEW
  CONTACTED
  SITE_VISIT
  QUOTED
  WON
  LOST
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  OTHER
}

model Lead {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  customerName     String
  phone            String
  email            String?
  address          String?    // customer address, shown on estimates and carried into the Connection on conversion
  requirementNotes String?    // free text the Admin fills in manually from the customer conversation
  source           LeadSource @default(OTHER)
  stage            LeadStage  @default(NEW)
  estimatedValue   Decimal?   @db.Decimal(12, 2)
  notes            LeadNote[]
  estimates        Estimate[]
  connection       Connection?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([tenantId, stage])
}

// ---------- Estimates ----------

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SolarBrand {
  WAAREE
  LUMINOUS
  MICROTEK
  RENEW
  VIKRAM
  ADANI
}

model Estimate {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id])
  estimateNumber  String         @unique // generated once at creation, stable across reprints
  version         Int            @default(1)
  isCurrent       Boolean        @default(true)
  systemSizeKw    Decimal?       @db.Decimal(6, 2)
  brand           SolarBrand?
  lineItems       Json           // {description, spec?, qty, rate, amount}[] — read/rendered as one document, never queried individually
  subtotal        Decimal        @db.Decimal(12, 2)
  gstPercent      Decimal        @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @db.Decimal(12, 2)
  subsidyEstimate Decimal?       @db.Decimal(12, 2)
  status          EstimateStatus @default(DRAFT)
  validUntil      DateTime?
  notes           String?        // terms & conditions shown on the printed estimate
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, leadId])
}

model LeadNote {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  body       String
  followUpAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, leadId])
}

// ---------- Inventory ----------

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  unit         String   @default("pcs")
  supplier     String?
  runningStock Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions InventoryTransaction[]

  @@index([tenantId])
}

enum InventoryTxnType {
  PURCHASE // stock IN from factory
  ALLOCATION // stock OUT, consumed by a Connection
  ADJUSTMENT // manual correction
}

model InventoryTransaction {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  type            InventoryTxnType
  quantity        Decimal          @db.Decimal(12, 2) // always positive; sign implied by type
  unitCost        Decimal?         @db.Decimal(12, 2) // required for PURCHASE; snapshotted onto ALLOCATION
  supplier        String?
  connectionId    String?
  connection      Connection?      @relation(fields: [connectionId], references: [id])
  note            String?
  purchaseDate    DateTime         @default(now())
  createdAt       DateTime         @default(now())

  @@index([tenantId, inventoryItemId])
  @@index([tenantId, connectionId])
}

// ---------- Connections (won leads -> installations) ----------

enum ConnectionStatus {
  SITE_INSPECTION_PENDING
  SITE_INSPECTION_DONE
  SUBSIDY_APPLIED
  SUBSIDY_APPROVED
  INSTALLATION_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubsidyStatus {
  NOT_APPLIED
  APPLIED
  APPROVED
  REJECTED
  DISBURSED
}

enum SiteVisitStatus {
  PENDING
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  RESCHEDULE_REQUESTED
  CANCELLED
}

enum SiteVisitResult {
  SUITABLE
  SUITABLE_WITH_CONDITIONS
  NOT_SUITABLE
  REQUIRES_FURTHER_INSPECTION
}

enum RoofType {
  RCC
  TIN
  TILED
  OTHER
}

enum RoofCondition {
  GOOD
  NEEDS_REPAIR
  POOR
}

enum RoofAccess {
  EASY
  LADDER_REQUIRED
  DIFFICULT
}

enum SitePhotoCategory {
  ROOF
  METER
  INSTALL_AREA
  DB_PANEL
  OTHER
}

model Connection {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  leadId            String           @unique
  lead              Lead             @relation(fields: [leadId], references: [id])
  customerName      String
  phone             String
  address           String?
  systemSizeKw      Decimal?         @db.Decimal(6, 2)
  status            ConnectionStatus @default(SITE_INSPECTION_PENDING)
  installDate       DateTime?
  assignedInstaller String? // free-text v1; StaffMember link is the Phase 2 upgrade path
  staffMemberId     String?
  staffMember       StaffMember?     @relation(fields: [staffMemberId], references: [id])

  // Site visit
  siteVisitStatus             SiteVisitStatus @default(PENDING)
  siteVisitScheduledAt        DateTime?
  siteVisitInstructions       String?
  roofType                    RoofType?
  roofCondition               RoofCondition?
  roofAreaSqft                Decimal?        @db.Decimal(8, 2)
  shadowObstruction           String?
  orientation                 String?
  roofAccess                  RoofAccess?
  electricalConnectionDetails String?
  meterInformation            String?
  otherSiteRequirements       String?
  siteVisitResult             SiteVisitResult?
  siteVisitWorkerNotes        String?
  sitePhotos                  SitePhoto[]

  // Document verification — fixed checklist for the standard PM Surya Ghar subsidy docs
  docIdProofVerified         Boolean @default(false)
  docAddressProofVerified    Boolean @default(false)
  docElectricityBillVerified Boolean @default(false)
  docOwnershipVerified       Boolean @default(false)
  docBankPassbookVerified    Boolean @default(false)
  documentNotes              String?

  // Government subsidy application
  subsidyScheme           String?       @default("PM Surya Ghar Muft Bijli Yojana")
  subsidyApplicationRefNo String?
  subsidyAppliedAmount    Decimal?      @db.Decimal(12, 2)
  subsidyApprovedAmount   Decimal?      @db.Decimal(12, 2)
  subsidyStatus           SubsidyStatus @default(NOT_APPLIED)
  subsidyAppliedAt        DateTime?
  subsidyApprovedAt       DateTime?
  subsidyDisbursedAt      DateTime?

  // Warranty (only meaningful once COMPLETED, but not hard-gated)
  warrantyStartDate    DateTime?
  warrantyPeriodMonths Int?
  warrantyNotes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryTxns InventoryTransaction[]
  payments      CustomerPayment[]

  @@index([tenantId, status])
}

model CustomerPayment {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  paidAt       DateTime   @default(now())
  note         String?

  @@index([tenantId, connectionId])
}

model SitePhoto {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   Connection        @relation(fields: [connectionId], references: [id])
  category     SitePhotoCategory
  filePath     String // path relative to /public, e.g. "uploads/<tenantId>/<connectionId>/<uuid>.jpg"
  originalName String
  uploadedAt   DateTime          @default(now())

  @@index([tenantId, connectionId])
}

model StaffMember {
  // non-login record for v1, see plan's flagged assumption
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  phone    String?
  isActive Boolean @default(true)
  userId   String? // NULL in v1; populate in Phase 2 if staff get real logins

  connections Connection[]

  @@index([tenantId])
}
