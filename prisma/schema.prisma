generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Platform / Tenancy ----------

enum BusinessType {
  SOLAR
  GENERIC // placeholder for future verticals
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  businessType BusinessType @default(SOLAR)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users               User[]
  leads               Lead[]
  inventoryItems      InventoryItem[]
  inventoryTxns       InventoryTransaction[]
  connections         Connection[]
  customerPayments    CustomerPayment[]
  staffMembers        StaffMember[]
  leadNotes           LeadNote[]
}

enum Role {
  SUPER_ADMIN // platform-level, tenantId is null
  ADMIN // tenant-scoped owner
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String
  role              Role
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  isActive          Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

// ---------- Leads ----------

enum LeadStage {
  NEW
  CONTACTED
  SITE_VISIT
  QUOTED
  WON
  LOST
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  OTHER
}

model Lead {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  customerName   String
  phone          String
  source         LeadSource @default(OTHER)
  stage          LeadStage  @default(NEW)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  notes          LeadNote[]
  connection     Connection?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId, stage])
}

model LeadNote {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  body       String
  followUpAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, leadId])
}

// ---------- Inventory ----------

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  unit         String   @default("pcs")
  supplier     String?
  runningStock Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions InventoryTransaction[]

  @@index([tenantId])
}

enum InventoryTxnType {
  PURCHASE // stock IN from factory
  ALLOCATION // stock OUT, consumed by a Connection
  ADJUSTMENT // manual correction
}

model InventoryTransaction {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  type            InventoryTxnType
  quantity        Decimal          @db.Decimal(12, 2) // always positive; sign implied by type
  unitCost        Decimal?         @db.Decimal(12, 2) // required for PURCHASE; snapshotted onto ALLOCATION
  supplier        String?
  connectionId    String?
  connection      Connection?      @relation(fields: [connectionId], references: [id])
  note            String?
  purchaseDate    DateTime         @default(now())
  createdAt       DateTime         @default(now())

  @@index([tenantId, inventoryItemId])
  @@index([tenantId, connectionId])
}

// ---------- Connections (won leads -> installations) ----------

enum ConnectionStatus {
  PENDING_INSTALL
  IN_PROGRESS
  INSTALLED
  CANCELLED
}

model Connection {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  leadId            String           @unique
  lead              Lead             @relation(fields: [leadId], references: [id])
  customerName      String
  phone             String
  address           String?
  systemSizeKw      Decimal?         @db.Decimal(6, 2)
  status            ConnectionStatus @default(PENDING_INSTALL)
  installDate       DateTime?
  assignedInstaller String? // free-text v1; StaffMember link is the Phase 2 upgrade path
  staffMemberId     String?
  staffMember       StaffMember?     @relation(fields: [staffMemberId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  inventoryTxns InventoryTransaction[]
  payments      CustomerPayment[]

  @@index([tenantId, status])
}

model CustomerPayment {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  paidAt       DateTime   @default(now())
  note         String?

  @@index([tenantId, connectionId])
}

model StaffMember {
  // non-login record for v1, see plan's flagged assumption
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  phone    String?
  isActive Boolean @default(true)
  userId   String? // NULL in v1; populate in Phase 2 if staff get real logins

  connections Connection[]

  @@index([tenantId])
}
