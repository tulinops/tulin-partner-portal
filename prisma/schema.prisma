generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Platform / Tenancy ----------

enum BusinessType {
  SOLAR
  GENERIC // placeholder for future verticals
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  businessType    BusinessType @default(SOLAR)
  isActive        Boolean      @default(true)
  // Letterhead details for printed estimates — edited by the tenant Admin
  // via the Business Profile page, not by Super Admin at onboarding time.
  businessAddress String?
  gstin           String?
  contactPhone    String?
  contactEmail    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users                 User[]
  leads                 Lead[]
  estimates             Estimate[]
  inventoryItems        InventoryItem[]
  inventoryTxns         InventoryTransaction[]
  connections           Connection[]
  customerPayments      CustomerPayment[]
  staffMembers          StaffMember[]
  leadNotes             LeadNote[]
  sitePhotos            SitePhoto[]
  requiredDocumentTypes RequiredDocumentType[]
  connectionDocuments   ConnectionDocument[]
  loanApplications      LoanApplication[]
  warrantyRecords       WarrantyRecord[]
  invoices              Invoice[]
}

enum Role {
  SUPER_ADMIN // platform-level, tenantId is null
  ADMIN // tenant-scoped owner
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               Role
  tenantId           String?
  tenant             Tenant?  @relation(fields: [tenantId], references: [id])
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  verifiedDocuments ConnectionDocument[] // documents this user uploaded/reviewed

  @@index([tenantId])
}

// ---------- Leads ----------

enum LeadStage {
  NEW
  CONTACTED
  SITE_VISIT
  QUOTED
  WON
  LOST
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  OTHER
}

model Lead {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  customerName     String
  phone            String
  email            String?
  address          String? // customer address, shown on estimates and carried into the Connection on conversion
  requirementNotes String? // free text the Admin fills in manually from the customer conversation
  source           LeadSource  @default(OTHER)
  stage            LeadStage   @default(NEW)
  estimatedValue   Decimal?    @db.Decimal(12, 2)
  notes            LeadNote[]
  estimates        Estimate[]
  connection       Connection?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([tenantId, stage])
}

// ---------- Estimates ----------

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  LOCKED
}

enum InvoiceStatus {
  DRAFT
  COMPLETE
}

enum SolarBrand {
  WAAREE
  LUMINOUS
  MICROTEK
  RENEW
  VIKRAM
  ADANI
}

model Estimate {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id])
  estimateNumber  String         @unique // generated once at creation, stable across reprints
  version         Int            @default(1)
  isCurrent       Boolean        @default(true)
  systemSizeKw    Decimal?       @db.Decimal(6, 2)
  brand           SolarBrand?
  lineItems       Json // {description, spec?, qty, rate, amount}[] — read/rendered as one document, never queried individually
  subtotal        Decimal        @db.Decimal(12, 2)
  gstPercent      Decimal        @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @db.Decimal(12, 2)
  subsidyEstimate Decimal?       @db.Decimal(12, 2)
  status          EstimateStatus @default(DRAFT)
  validUntil      DateTime?
  notes           String? // terms & conditions shown on the printed estimate
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, leadId])
}

model LeadNote {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  body       String
  followUpAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, leadId])
}

// ---------- Inventory ----------

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  brand        String?
  unit         String   @default("pcs")
  supplier     String?
  runningStock Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions InventoryTransaction[]

  @@index([tenantId])
}

enum InventoryTxnType {
  PURCHASE // stock IN from factory
  ALLOCATION // stock OUT, consumed by a Connection
  ADJUSTMENT // manual correction
}

model InventoryTransaction {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  type            InventoryTxnType
  quantity        Decimal          @db.Decimal(12, 2) // always positive; sign implied by type
  unitCost        Decimal?         @db.Decimal(12, 2) // required for PURCHASE; snapshotted onto ALLOCATION
  supplier        String?
  brand           String? // this purchase's brand, may differ from the item's own default brand
  connectionId    String?
  connection      Connection?      @relation(fields: [connectionId], references: [id])
  note            String?
  purchaseDate    DateTime         @default(now())
  createdAt       DateTime         @default(now())

  @@index([tenantId, inventoryItemId])
  @@index([tenantId, connectionId])
}

// ---------- Connections (won leads -> installations) ----------

enum ConnectionStatus {
  SITE_INSPECTION_PENDING
  SITE_INSPECTION_DONE
  SUBSIDY_APPLIED
  SUBSIDY_APPROVED
  INSTALLATION_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubsidyStatus {
  NOT_APPLIED
  APPLIED
  APPROVED
  REJECTED
  DISBURSED
}

enum SiteVisitStatus {
  PENDING
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  RESCHEDULE_REQUESTED
  CANCELLED
}

enum SiteVisitResult {
  SUITABLE
  SUITABLE_WITH_CONDITIONS
  NOT_SUITABLE
  REQUIRES_FURTHER_INSPECTION
}

enum SitePhotoCategory {
  ROOF
  METER
  INSTALL_AREA
  DB_PANEL
  OTHER
}

// ---------- Documents / Subsidy-Loan / Installation / Warranty ----------

enum DocumentStatus {
  NOT_UPLOADED
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REUPLOAD_REQUIRED
}

enum FinancingMethod {
  NOT_SELECTED
  FULL_PAYMENT
  LOAN
}

enum LoanStatus {
  NOT_REQUIRED
  APPLICATION_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  COMPLETED
}

enum InstallationStatus {
  PENDING
  SCHEDULED
  TEAM_ASSIGNED
  IN_PROGRESS
  INSPECTION_PENDING
  COMPLETED
}

enum EquipmentType {
  PANEL
  INVERTER
  MOUNTING_STRUCTURE
  DC_CABLE
  AC_CABLE
  EARTHING_KIT
  LIGHTNING_ARRESTOR
  NET_METER
  OTHER
}

enum WarrantyType {
  PRODUCT
  PERFORMANCE
  WORKMANSHIP
}

model Connection {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  leadId            String           @unique
  lead              Lead             @relation(fields: [leadId], references: [id])
  customerName      String
  phone             String
  address           String?
  systemSizeKw      Decimal?         @db.Decimal(6, 2)
  status            ConnectionStatus @default(SITE_INSPECTION_PENDING)
  installDate       DateTime?
  assignedInstaller String? // free-text v1; StaffMember link is the Phase 2 upgrade path
  staffMemberId     String?
  staffMember       StaffMember?     @relation(fields: [staffMemberId], references: [id])

  // Site visit
  siteVisitStatus       SiteVisitStatus  @default(PENDING)
  siteVisitScheduledAt  DateTime?
  siteVisitInstructions String?
  // Property-inspection fields, as one JSON blob rather than individually
  // typed columns — this is exactly the kind of business-specific data
  // shape likely to differ between solar proprietors, so it stays flexible
  // per-tenant instead of locking the schema to this one proprietor's
  // fields. Shape: {roofType, roofCondition, roofAreaSqft,
  // shadowObstruction, orientation, roofAccess,
  // electricalConnectionDetails, meterInformation, otherRequirements}.
  // See SiteInspectionDetails in src/server/connections.ts.
  siteInspectionDetails Json?
  siteVisitResult       SiteVisitResult?
  siteVisitWorkerNotes  String?
  sitePhotos            SitePhoto[]

  // Document verification — configurable per tenant via RequiredDocumentType/ConnectionDocument
  connectionDocuments ConnectionDocument[]

  // Government subsidy application (Option A: paid in full, subsidy credited
  // directly to the CUSTOMER's own bank account — this is tracking-only,
  // never proprietor revenue) vs. Option B: bank loan (LoanApplication)
  financingMethod         FinancingMethod   @default(NOT_SELECTED)
  subsidyScheme           String?           @default("PM Surya Ghar Muft Bijli Yojana")
  subsidyApplicationRefNo String?
  subsidyAppliedAmount    Decimal?          @db.Decimal(12, 2)
  subsidyApprovedAmount   Decimal?          @db.Decimal(12, 2)
  subsidyStatus           SubsidyStatus     @default(NOT_APPLIED)
  subsidyAppliedAt        DateTime?
  subsidyApprovedAt       DateTime?
  subsidyDisbursedAt      DateTime?
  loanApplications        LoanApplication[]

  // Installation
  installationStatus          InstallationStatus @default(PENDING)
  installationNotes           String?
  installationSignedOffAt     DateTime?
  installationSignedOffByName String?
  // Array of {type, brand, model, serialNumber, quantity, notes} — same
  // pattern as Estimate.lineItems: always read/edited together per
  // connection, never queried individually across connections.
  installedEquipment          Json?

  // Warranty — kept as real WarrantyRecord rows (not JSON), the one
  // deliberate exception to the JSON-for-variable-shape-data rule above,
  // because it needs to support a future cross-connection "expiring soon"
  // dashboard that's much easier against real columns than a JSON blob.
  warrantyRecords WarrantyRecord[]

  // One invoice per connection — generated on demand (not automatically),
  // seeded from installedEquipment so it reflects what was actually
  // installed, then freely editable.
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryTxns InventoryTransaction[]
  payments      CustomerPayment[]

  @@index([tenantId, status])
}

model RequiredDocumentType {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connectionDocuments ConnectionDocument[]

  @@index([tenantId, isActive])
}

model ConnectionDocument {
  id                     String               @id @default(cuid())
  tenantId               String
  tenant                 Tenant               @relation(fields: [tenantId], references: [id])
  connectionId           String
  connection             Connection           @relation(fields: [connectionId], references: [id])
  requiredDocumentTypeId String
  requiredDocumentType   RequiredDocumentType @relation(fields: [requiredDocumentTypeId], references: [id])
  status                 DocumentStatus       @default(NOT_UPLOADED)
  filePath               String? // same public/uploads/<tenantId>/<connectionId>/<uuid> pattern as SitePhoto
  originalName           String?
  uploadedAt             DateTime?
  uploadedById           String?
  uploadedBy             User?                @relation(fields: [uploadedById], references: [id])
  remarks                String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([tenantId, connectionId])
  @@index([tenantId, requiredDocumentTypeId])
}

model LoanApplication {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  // Supports the reapplication case (rejected -> reapplied elsewhere) —
  // mirrors Estimate.version/isCurrent.
  isCurrent    Boolean    @default(true)

  bankName                          String
  applicationNumber                 String?
  loanAmount                        Decimal    @db.Decimal(12, 2)
  applicationDate                   DateTime?
  status                            LoanStatus @default(APPLICATION_PENDING)
  sanctionedAt                      DateTime?
  sanctionedAmount                  Decimal?   @db.Decimal(12, 2)
  disbursedAmount                   Decimal?   @db.Decimal(12, 2)
  disbursedAt                       DateTime?
  // The only slice of this that is actual proprietor revenue — customer
  // payment (CustomerPayment) and subsidy (Connection.subsidy*) are
  // tracked separately and must never be summed with this.
  paymentReceivedByProprietorAmount Decimal?   @db.Decimal(12, 2)
  paymentReceivedByProprietorAt     DateTime?
  paymentReference                  String?
  notes                             String?
  createdAt                         DateTime   @default(now())
  updatedAt                         DateTime   @updatedAt

  @@index([tenantId, connectionId])
}

model WarrantyRecord {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])

  equipmentType EquipmentType
  productName   String
  manufacturer  String?
  model         String?
  serialNumber  String?
  warrantyType  WarrantyType  @default(PRODUCT)
  startDate     DateTime
  periodMonths  Int // e.g. 300 for 25yr panels, 60-120 for 5-10yr inverters
  terms         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // No stored expiry date — computed at read time (startDate + periodMonths),
  // same convention already used for Connection's profit figure.

  @@index([tenantId, connectionId])
}

model Invoice {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  connectionId String     @unique
  connection   Connection @relation(fields: [connectionId], references: [id])

  invoiceNumber String   @unique // generated once at creation, stable across reprints
  invoiceDate   DateTime @default(now())
  // {description, spec?, qty, rate, amount}[] — same shape/rationale as
  // Estimate.lineItems, but seeded from the connection's actual
  // installedEquipment rather than the original quotation, since on-site
  // extras beyond what was quoted are common and the invoice must reflect
  // what was really installed.
  lineItems   Json
  subtotal    Decimal  @db.Decimal(12, 2)
  gstPercent  Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
  notes       String? // terms & conditions shown on the printed invoice
  status      InvoiceStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, connectionId])
}

model CustomerPayment {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  paidAt       DateTime   @default(now())
  note         String?

  @@index([tenantId, connectionId])
}

model SitePhoto {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  connectionId String
  connection   Connection        @relation(fields: [connectionId], references: [id])
  category     SitePhotoCategory
  filePath     String // path relative to /public, e.g. "uploads/<tenantId>/<connectionId>/<uuid>.jpg"
  originalName String
  uploadedAt   DateTime          @default(now())

  @@index([tenantId, connectionId])
}

model StaffMember {
  // non-login record for v1, see plan's flagged assumption
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  phone       String?
  designation String?
  address     String?
  isActive    Boolean  @default(true)
  userId      String? // NULL in v1; populate in Phase 2 if staff get real logins
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections Connection[]

  @@index([tenantId])
}
